<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>me.kerballone.TheExpanse</AssemblyName>
    <RootNamespace>TheExpanse</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Hardspace Shipbreaker</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"
               HintPath="$(GameDir)\BepInEx\core\BepInEx.dll"
               Private="false" />
    <Reference Include="0Harmony"
               HintPath="$(GameDir)\BepInEx\core\0Harmony.dll"
               Private="false" />
    <Reference Include="BBI.Unity.Game"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\BBI.Unity.Game.dll"
               Private="false" />
    <Reference Include="Carbon.Core"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Carbon.Core.dll"
               Private="false" />
    <Reference Include="UnityEngine"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.dll"
               Private="false" />
    <Reference Include="UnityEngine.CoreModule"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.CoreModule.dll"
               Private="false" />
    <Reference Include="UnityEngine.PhysicsModule"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.PhysicsModule.dll"
               Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.ImageConversionModule.dll"
               Private="false" />
    <Reference Include="UnityEngine.UI"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.UI.dll"
               Private="false" />
    <Reference Include="UnityEngine.UIModule"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.UIModule.dll"
               Private="false" />
    <Reference Include="Unity.Entities"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.Entities.dll"
               Private="false" />
    <Reference Include="Unity.Collections"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.Collections.dll"
               Private="false" />
    <Reference Include="Unity.Mathematics"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.Mathematics.dll"
               Private="false" />
    <Reference Include="Unity.Addressables"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.Addressables.dll"
               Private="false" />
    <Reference Include="Unity.ResourceManager"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.ResourceManager.dll"
               Private="false" />
  </ItemGroup>

  <Target Name="DeployToBepInEx" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\TheExpanse\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(GameDir)\BepInEx\plugins\TheExpanse\" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Mars.png"
          DestinationFolder="$(GameDir)\BepInEx\plugins\TheExpanse\"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <LoadScreenPicture Include="$(MSBuildProjectDirectory)\LoadScreens\*.png;$(MSBuildProjectDirectory)\LoadScreens\*.jpg;$(MSBuildProjectDirectory)\LoadScreens\*.jpeg" />
    </ItemGroup>
    <ItemGroup>
      <TitleScreenPicture Include="$(MSBuildProjectDirectory)\TitleScreens\*.png;$(MSBuildProjectDirectory)\TitleScreens\*.jpg;$(MSBuildProjectDirectory)\TitleScreens\*.jpeg" />
    </ItemGroup>
    <Copy SourceFiles="@(TitleScreenPicture)"
          DestinationFolder="$(GameDir)\BepInEx\plugins\TheExpanse\TitleScreens\"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\TheExpanse\LoadScreens\" />
    <Copy SourceFiles="@(LoadScreenPicture)"
          DestinationFolder="$(GameDir)\BepInEx\plugins\TheExpanse\LoadScreens\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
