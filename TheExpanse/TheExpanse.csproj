               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.ParticleSystemModule.dll"
               Private="false" />
    <Reference Include="Carbon.Localization.Core"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Carbon.Localization.Core.dll"
               Private="false" />
    <Reference Include="Doozy.Engine"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Doozy.Engine.dll"
               Private="false" />
    <Reference Include="InControl"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\InControl.dll"
               Private="false" />
    <Reference Include="Unity.TextMeshPro"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.TextMeshPro.dll"
               Private="false" />
    <Reference Include="UnityEngine.UI"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.UI.dll"
               Private="false" />
    <Reference Include="UnityEngine.UIModule"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.UIModule.dll"
               Private="false" />
    <Reference Include="Wwise.Unity"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Wwise.Unity.dll"
