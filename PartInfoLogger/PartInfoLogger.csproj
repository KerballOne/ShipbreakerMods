<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>me.kerballone.PartInfoLogger</AssemblyName>
    <RootNamespace>PartInfoLogger</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Optimize>false</Optimize>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Hardspace Shipbreaker</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"
               HintPath="$(GameDir)\BepInEx\core\BepInEx.dll"
               Private="false" />
    <Reference Include="0Harmony"
               HintPath="$(GameDir)\BepInEx\core\0Harmony.dll"
               Private="false" />
    <Reference Include="BBI.Unity.Game"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\BBI.Unity.Game.dll"
               Private="false" />
    <Reference Include="UnityEngine"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.dll"
               Private="false" />
    <Reference Include="UnityEngine.CoreModule"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.CoreModule.dll"
               Private="false" />
    <Reference Include="Unity.Entities"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.Entities.dll"
               Private="false" />
    <Reference Include="Unity.Entities.Hybrid"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.Entities.Hybrid.dll"
               Private="false" />
    <Reference Include="Newtonsoft.Json"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Newtonsoft.Json.dll"
               Private="false" />
    <Reference Include="Carbon.Localization.Core"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Carbon.Localization.Core.dll"
               Private="false" />
    <Reference Include="Carbon.Core"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Carbon.Core.dll"
               Private="false" />
    <Reference Include="Unity.Addressables"
               HintPath="$(GameDir)\Shipbreaker_Data\Managed\Unity.Addressables.dll"
               Private="false" />
  </ItemGroup>

  <Target Name="DeployToBepInEx" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\PartInfoLogger\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(GameDir)\BepInEx\plugins\PartInfoLogger\" />
  </Target>
</Project>
