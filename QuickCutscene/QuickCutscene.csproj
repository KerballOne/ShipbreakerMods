<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>me.kerballone.QuickCutscene</AssemblyName>
    <RootNamespace>QuickCutscene</RootNamespace>
    <Version>1.1.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Hardspace Shipbreaker</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"            HintPath="$(GameDir)\BepInEx\core\BepInEx.dll"                         Private="false" />
    <Reference Include="0Harmony"           HintPath="$(GameDir)\BepInEx\core\0Harmony.dll"                        Private="false" />
    <Reference Include="BBI.Unity.Game"     HintPath="$(GameDir)\Shipbreaker_Data\Managed\BBI.Unity.Game.dll"      Private="false" />
    <Reference Include="Carbon.Core"        HintPath="$(GameDir)\Shipbreaker_Data\Managed\Carbon.Core.dll"         Private="false" />
    <Reference Include="UnityEngine"            HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.dll"            Private="false" />
    <Reference Include="UnityEngine.CoreModule"   HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.CoreModule.dll"   Private="false" />
    <Reference Include="UnityEngine.DirectorModule" HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.DirectorModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule"          HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.IMGUIModule.dll"          Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameDir)\Shipbreaker_Data\Managed\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="InControl"                HintPath="$(GameDir)\Shipbreaker_Data\Managed\InControl.dll"                       Private="false" />
    <Reference Include="Doozy.Engine"            HintPath="$(GameDir)\Shipbreaker_Data\Managed\Doozy.Engine.dll"                    Private="false" />
  </ItemGroup>

  <!-- Copy output to BepInEx plugins after build -->
  <Target Name="DeployToBepInEx" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(GameDir)\BepInEx\plugins\QuickCutscene\" />
  </Target>
</Project>
